// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id             String   @id
  source         String   // 'gamejob' | 'wanted' — id 앞 prefix와 동일
  sourceId       String   // 원본 사이트의 공고 ID (prefix 없는 값)
  company        String
  companyUrl     String
  title          String
  detailUrl      String
  deadline       String   // 원문 텍스트: "상시" · "채용시" · "04/03(금)" 등 — 날짜가 아닐 수 있어 String 유지
  /// `deadline` 텍스트를 cron 시점에 파싱한 결과. "상시"/파싱불가는 null.
  /// 마감 임박 정렬·필터·알림의 기준 컬럼. 인덱스로 sort/where 가속.
  deadlineAt     DateTime? @db.Timestamptz(3)
  registeredAt   DateTime @db.Timestamptz(3)
  tags           String[]
  gameTitle      String?
  imageQuery     String
  imageQueryType String
  firstSeenAt    DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime @default(now()) @db.Timestamptz(3)

  // 상세페이지 enrichment — /api/job-images?id= 최초 호출 시 lazy 채움
  companyLogoUrl      String?
  companyPhotos       String[] @default([])
  representativeGames String[] @default([])
  // 공고 본문 iframe에서 회사가 직접 업로드한 광고/배너 이미지 (게임 키아트인 경우 많음)
  bodyImages          String[] @default([])
  detailScrapedAt     DateTime? @db.Timestamptz(3)

  // 만료 플래그 — cron이 lastSeenAt + 7d 경과 시 채움. 응답엔 expired:boolean 으로 노출.
  expiredAt           DateTime? @db.Timestamptz(3)

  // 다중 소스 dedup 영속화. normalizedKey는 (company+title) 정규화 결과.
  // primaryJobId가 null이면 이 잡이 primary, 아니면 그 잡의 alias.
  // 사용자 응답 경로는 primaryJobId is null만 노출하고 aliases는 alternateSources로 합성.
  normalizedKey  String?
  primaryJobId   String?
  primary        Job?     @relation("JobAliases", fields: [primaryJobId], references: [id], onDelete: SetNull)
  aliases        Job[]    @relation("JobAliases")

  // tags + title에서 cron 시점에 추출되는 derived 속성. UI 필터/통계용.
  experienceLevel String?
  employmentType  String?
  locations       String[] @default([])
  isRemote        Boolean  @default(false)

  /// 게시자가 공고에 단 직군 라벨(게임잡 원문). 예: ["원화","애니메이션"].
  /// 게임잡 외 소스는 목록에 직군을 주지 않아 빈 배열이다.
  /// 빈 배열을 "직군 없음"으로 읽어 조회에서 빼면 기존 공고와 타 소스 공고가 통째로
  /// 사라진다. 조회 계층은 빈 배열을 제외 조건으로 쓰지 않는다.
  jobFamilies     String[] @default([])
  /// 원화 하위 구분. 예: ["캐릭터"], ["배경·컨셉"]. 원화 직군이 아니면 빈 배열이다.
  artSubtypes     String[] @default([])

  @@index([registeredAt])
  @@index([deadlineAt])
  @@index([expiredAt])
  @@index([source])
  @@index([normalizedKey])
  @@index([primaryJobId])
  @@index([experienceLevel])
  @@index([employmentType])
  @@index([isRemote])
  @@index([jobFamilies], type: Gin)
  @@map("jobs")
}

// 검색어 → 이미지 URL 캐시. `query`(실제 네이버 검색 문자열)가 PK이며 여러 공고가 한 행을 공유한다.
// `queryType`은 이 검색어가 게임명/회사명 경로 중 어디서 왔는지 기록하는 정보성 메타데이터(키 아님).
model GameImage {
  query      String   @id
  queryType  String
  imageUrl   String?
  status     String
  source     String
  fetchedAt  DateTime @default(now()) @db.Timestamptz(3)

  @@map("game_images")
}

// 사용자가 "이 이미지 잘못됐어요" 버튼으로 신고한 이미지 URL. 신고된 URL은
// JobImagesService가 응답에서 제거하고, 다음 크롤 사이클의 후보에서도 제외된다.
// 같은 URL이 여러 잡에서 신고되어도 모두 기록 (분석용) — 응답 필터에선 imageUrl만 사용.
model BadImageReport {
  id         String   @id @default(cuid())
  imageUrl   String
  jobId      String?
  reason     String?
  reportedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([imageUrl])
  @@index([jobId])
  @@map("bad_image_reports")
}

// cron 실행 이력 ledger — GitHub Actions `refresh-jobs.yml`가 실행될 때마다 한 줄.
// 운영 가시성: 실행 빈도/지속시간/실패율, 소스별 페이지 적재 추세를 한 테이블로 추적.
// status:
//   'success'         — totalFailure 없이 정상 완료
//   'partial_failure' — 일부 페이지에서 일부 소스 실패. 적재는 진행됨.
//   'total_failure'   — 어느 페이지에서 모든 소스가 동시 실패. 적재 중단.
//   'crashed'         — main 함수가 예외로 종료. errorMessage 참조.
model CronRun {
  id                       String   @id @default(cuid())
  startedAt                DateTime @default(now()) @db.Timestamptz(3)
  finishedAt               DateTime? @db.Timestamptz(3)
  status                   String
  pagesProcessed           Int      @default(0)
  scrapedTotal             Int      @default(0)
  dedupedTotal             Int      @default(0)
  newTotal                 Int      @default(0)
  expiredSwept             Int      @default(0)
  detailRescrapeAttempted  Int      @default(0)
  detailRescrapeUpdated    Int      @default(0)
  detailRescrapeFailed     Int      @default(0)
  /// 사이클 전체에서 한 번 이상 실패한 소스 합집합. 'gamejob' | 'wanted' | ...
  failedSources            String[] @default([])
  /// crashed 상태일 때만 의미 있음. 메시지는 첫 140자만.
  errorMessage             String?
  /// finishedAt - startedAt(ms). crashed에서도 가능하면 채움.
  durationMs               Int?

  @@index([startedAt])
  @@map("cron_runs")
}

// 나무위키 게임 페이지 대표 이미지 캐시 — `apps/crawler`가 cron으로 채운다.
// 키는 정규화된 게임명(공백/대소문자 그대로, '게임' suffix 없는 원형). api는 read-only.
// status:
//   'found'      — imageUrl 채워짐
//   'not_found'  — 페이지는 있는데 대표 이미지 추출 실패 또는 페이지 자체 없음
//   'blocked'    — 차단/봇 감지 (다음 크론에서 재시도)
model NamuwikiImage {
  gameName  String   @id
  imageUrl  String?
  status    String
  fetchedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("namuwiki_images")
}
