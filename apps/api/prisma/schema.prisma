// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id             String   @id
  source         String   // 'gamejob' | 'wanted' — id 앞 prefix와 동일
  sourceId       String   // 원본 사이트의 공고 ID (prefix 없는 값)
  company        String
  companyUrl     String
  title          String
  detailUrl      String
  deadline       String   // 원문 텍스트: "상시" · "채용시" · "04/03(금)" 등 — 날짜가 아닐 수 있어 String 유지
  registeredAt   DateTime @db.Timestamptz(3)
  tags           String[]
  gameTitle      String?
  imageQuery     String
  imageQueryType String
  firstSeenAt    DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime @default(now()) @db.Timestamptz(3)

  // 상세페이지 enrichment — /api/job-images?id= 최초 호출 시 lazy 채움
  companyLogoUrl      String?
  companyPhotos       String[] @default([])
  representativeGames String[] @default([])
  // 공고 본문 iframe에서 회사가 직접 업로드한 광고/배너 이미지 (게임 키아트인 경우 많음)
  bodyImages          String[] @default([])
  detailScrapedAt     DateTime? @db.Timestamptz(3)

  // 만료 플래그 — cron이 lastSeenAt + 7d 경과 시 채움. 응답엔 expired:boolean 으로 노출.
  expiredAt           DateTime? @db.Timestamptz(3)

  @@index([registeredAt])
  @@index([expiredAt])
  @@index([source])
  @@map("jobs")
}

// 검색어 → 이미지 URL 캐시. `query`(실제 네이버 검색 문자열)가 PK이며 여러 공고가 한 행을 공유한다.
// `queryType`은 이 검색어가 게임명/회사명 경로 중 어디서 왔는지 기록하는 정보성 메타데이터(키 아님).
model GameImage {
  query      String   @id
  queryType  String
  imageUrl   String?
  status     String
  source     String
  fetchedAt  DateTime @default(now()) @db.Timestamptz(3)

  @@map("game_images")
}

// 사용자가 "이 이미지 잘못됐어요" 버튼으로 신고한 이미지 URL. 신고된 URL은
// JobImagesService가 응답에서 제거하고, 다음 크롤 사이클의 후보에서도 제외된다.
// 같은 URL이 여러 잡에서 신고되어도 모두 기록 (분석용) — 응답 필터에선 imageUrl만 사용.
model BadImageReport {
  id         String   @id @default(cuid())
  imageUrl   String
  jobId      String?
  reason     String?
  reportedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([imageUrl])
  @@index([jobId])
  @@map("bad_image_reports")
}

// 나무위키 게임 페이지 대표 이미지 캐시 — `apps/crawler`가 cron으로 채운다.
// 키는 정규화된 게임명(공백/대소문자 그대로, '게임' suffix 없는 원형). api는 read-only.
// status:
//   'found'      — imageUrl 채워짐
//   'not_found'  — 페이지는 있는데 대표 이미지 추출 실패 또는 페이지 자체 없음
//   'blocked'    — 차단/봇 감지 (다음 크론에서 재시도)
model NamuwikiImage {
  gameName  String   @id
  imageUrl  String?
  status    String
  fetchedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("namuwiki_images")
}
